# Robô de preços — API do Mercado Livre (developers.mercadolivre.com.br)
# Só o robô usa: nada disso vai pro navegador, por isso sem NEXT_PUBLIC_.
# No GitHub, os três viram segredos em Settings > Secrets and variables > Actions.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# De uso único: o robô troca por um novo a cada rodada e reescreve este arquivo.
ML_REFRESH_TOKEN=
# Tem que ser igual, caractere por caractere, à cadastrada no app do Meli.
ML_REDIRECT_URI=

# Metricool
NEXT_PUBLIC_METRICOOL_MCP_URL=https://ai.metricool.com/mcp

# Mercado Livre Afiliados
NEXT_PUBLIC_ML_AFFILIATE_PROGRAM_ID=MLB1648
NEXT_PUBLIC_ML_AFFILIATE_TRACKING_ID=seu-tracking-id-aqui

# Shopee
NEXT_PUBLIC_SHOPEE_AFFILIATE_ID=seu-affiliate-id-shopee

# Amazon
NEXT_PUBLIC_AMAZON_ASSOCIATE_ID=seu-associate-id-amazon

# Deploy
# Endereço público do site. Em branco = localhost. Na Vercel, o VERCEL_URL
# é detectado sozinho, então só preencha quando o domínio próprio entrar.
NEXT_PUBLIC_SITE_URL=
