# Robô de preços — API do Mercado Livre (developers.mercadolivre.com.br)
# Só o robô usa: nada disso vai pro navegador, por isso sem NEXT_PUBLIC_.
# No GitHub, os três primeiros viram segredos em
# Settings > Secrets and variables > Actions.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# De uso único: o robô troca por um novo a cada rodada e reescreve este arquivo.
ML_REFRESH_TOKEN=
# Tem que ser igual, caractere por caractere, à cadastrada no app do Meli.
ML_REDIRECT_URI=

# Não existe variável de endereço do site: as metatags saem do
# VERCEL_PROJECT_PRODUCTION_URL, que a própria Vercel preenche.
